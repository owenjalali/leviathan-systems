# Public URLs
APP_BASE_URL=https://your-public-app.example
BOOKING_MANAGE_BASE_URL=https://your-public-app.example

# Token secrets
# AUDIT_LEAD_TOKEN_SECRET signs the short-lived post-intake lead token.
AUDIT_LEAD_TOKEN_SECRET=replace-with-generated-secret
BOOKING_MANAGE_TOKEN_SECRET=replace-with-generated-secret
# HEALTH_SECRET unlocks authenticated booking diagnostics on /api/health/booking.
HEALTH_SECRET=replace-with-generated-secret

# Booking policy
BOOKING_TIMEZONE=America/Toronto
BOOKING_WORKING_DAYS=0,1,2,3,4,5,6
BOOKING_DAY_START=09:00
BOOKING_DAY_END=21:00
BOOKING_SLOT_DURATION_MINUTES=30
BOOKING_SLOT_INTERVAL_MINUTES=30
BOOKING_MIN_NOTICE_MINUTES=240
BOOKING_SELF_SERVICE_CUTOFF_MINUTES=720
BOOKING_GOOGLE_SEND_UPDATES=all
BOOKING_REMINDER_LEAD_MINUTES=60

# Google Calendar OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REFRESH_TOKEN=replace-with-google-refresh-token
GOOGLE_CALENDAR_ID=replace-with-google-calendar-id
GOOGLE_ORGANIZER_EMAIL=calendar-owner@example.com
BOOKING_OWNER_EMAIL=ops@example.com

# SMTP delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Leviathan Systems <notifications@example.com>
SMTP_REPLY_TO=ops@example.com

# Trigger.dev
# Use environment-specific keys: staging for preview deploys, prod for production deploys.
TRIGGER_SECRET_KEY=replace-with-trigger-secret
TRIGGER_PROJECT_REF=replace-with-trigger-project-ref

# Deploy-time only: used by Trigger build env sync and Vercel CLI, not by the app runtime.
VERCEL_ACCESS_TOKEN=replace-with-vercel-access-token
VERCEL_PROJECT_ID=replace-with-vercel-project-id
VERCEL_TEAM_ID=replace-with-vercel-team-id
