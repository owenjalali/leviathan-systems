    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sessionData = items[0].json.sessionData;\n\nlet data;\ntry {\n  data = typeof sessionData === 'string' ? JSON.parse(sessionData) : sessionData;\n} catch (e) {\n  data = sessionData;\n}\n\nreturn [{\n  json: {\n    success: true,\n    data: data,\n    retrieved_at: new Date().toISOString()\n  }\n}];"
      },
