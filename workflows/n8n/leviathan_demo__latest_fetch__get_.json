      ],
      "webhookId": "demo-latest"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst query = items[0].json.query || {};\nconst demo_session_id = query.demo_session_id;\n\nif (!demo_session_id) {\n  return [{ json: { valid: false, error: 'Missing required query parameter: demo_session_id', statusCode: 400 } }];\n}\n\n// UUID format validation\nconst uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!uuidRegex.test(demo_session_id)) {\n  return [{ json: { valid: false, error: 'Invalid demo_session_id format: must be UUID', statusCode: 400 } }];\n}\n\nreturn [{ json: { valid: true, demo_session_id, redisKey: `leviathan:demo:${demo_session_id}` } }];"
      },
