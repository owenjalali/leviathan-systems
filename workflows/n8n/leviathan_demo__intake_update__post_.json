{
  "name": "Leviathan Demo: Intake Update (POST)",
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "demo/update",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "POST /demo/update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ZA1G8OX2FS1MrJkW",
          "name": "Header Auth account 2"
        }
      },
      "webhookId": "demo-update"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst rawBody = items[0].json.body || items[0].json;\nlet body, toolCallId = null;\n\n// Check if this is Vapi tool-calls format\nif (rawBody.message && rawBody.message.type === 'tool-calls' && rawBody.message.toolCalls) {\n  const toolCall = rawBody.message.toolCalls[0];\n  toolCallId = toolCall.id;\n  body = toolCall.function.arguments;\n} else {\n  // Direct format\n  body = rawBody;\n}\n\n// Required validation\nif (!body.demo_session_id) {\n  return [{ json: { valid: false, error: 'Missing required field: demo_session_id', statusCode: 400, toolCallId } }];\n}\n\nreturn [{ json: { valid: true, toolCallId, new_data: body, redis_key: `leviathan:demo:${body.demo_session_id}` } }];"
      },
      "id": "parse-input",
      "name": "Parse & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cv",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-valid",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "key": "={{ $json.redis_key }}",
        "keyType": "string"
      },
      "id": "redis-get",
      "name": "Get Existing Data",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        660,
        -100
      ],
      "alwaysOutputData": true,
      "continueOnFail": true,
      "credentials": {
        "redis": {
          "id": "lsEDDWlEEgHbDnjF",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prevNode = $items('Parse & Validate')[0].json;\nconst newData = prevNode.new_data;\nconst existingStr = $input.all()[0]?.json?.data;\nlet existingData = {};\n\ntry {\n  if (existingStr) existingData = JSON.parse(existingStr);\n} catch(e) {}\n\n// MERGE LOGIC: Existing + New\nconst merged = { ...existingData, ...newData };\n\n// Ensure timestamps and critical fields\nmerged.last_update_ts = new Date().toISOString();\nmerged.control_statement = 'No actions taken without owner approval.';\nif (newData.status) merged.status = newData.status;\nif (newData.final_summary) merged.final_summary = newData.final_summary;\n\nreturn [{ json: { merged_data: merged, redis_key: prevNode.redis_key, toolCallId: prevNode.toolCallId } }];"
      },
      "id": "merge-data",
      "name": "Merge Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "={{ $json.redis_key }}",
        "value": "={{ JSON.stringify($json.merged_data) }}",
        "keyType": "string",
        "expire": true,
        "ttl": 7200
      },
      "id": "redis-set",
      "name": "Save Merged Data",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1100,
        -100
      ],
      "credentials": {
        "redis": {
          "id": "lsEDDWlEEgHbDnjF",
          "name": "Redis account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.toolCallId ? JSON.stringify({ results: [{ toolCallId: $json.toolCallId, result: 'Data merged successfully' }] }) : JSON.stringify({ success: true, message: 'Update merged', timestamp: $now.toISO() }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "return-success",
      "name": "Return Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1320,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: $json.error }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "return-error",
      "name": "Return Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        660,
        150
      ]
    }
  ],
  "connections": {
    "POST /demo/update": {
      "main": [
        [
          {
            "node": "Parse & Validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse & Validate": {
      "main": [
        [
          {
            "node": "Is Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Valid?": {
      "main": [
        [
          {
            "node": "Get Existing Data",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Return Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Existing Data": {
      "main": [
        [
          {
            "node": "Merge Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge Data": {
      "main": [
        [
          {
            "node": "Save Merged Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Merged Data": {
      "main": [
        [
          {
            "node": "Return Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}